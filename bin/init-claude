#!/bin/bash
# init-claude — scaffold .claude/ in the current project
# Usage (plugin):   /init-floor   (runs: bash ${CLAUDE_PLUGIN_ROOT}/bin/init-claude)
# Usage (checkout): cd your-project && /path/to/claude-setup/bin/init-claude
#
# The template ships INSIDE the plugin/repo (script-relative), so there is no
# separate installed copy to drift out of date (#13). ~/.claude-template is a
# legacy fallback for pre-plugin installs.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -d "$CLAUDE_PLUGIN_ROOT/template" ]; then
  TEMPLATE="$CLAUDE_PLUGIN_ROOT/template"
elif [ -d "$SCRIPT_DIR/../template" ]; then
  TEMPLATE="$(cd "$SCRIPT_DIR/../template" && pwd)"
elif [ -d "$HOME/.claude-template" ]; then
  TEMPLATE="$HOME/.claude-template"   # legacy pre-plugin install
else
  echo "❌ Template not found (looked in the plugin root, next to this script, and ~/.claude-template)."
  echo "   Install the claude-setup plugin, or run this script from a repo checkout."
  exit 1
fi

# A `.claude/` can exist in a project that was NEVER scaffolded: the Claude Code
# app creates `.claude/.cc-writes/` to track its own file writes, and writes
# `.claude/settings.local.json` the first time you approve a permission with
# "don't ask again". So the folder is present in anything a session has been
# open in. Refusing on bare existence broke the documented path outright —
# `/init-floor` is a slash command, so a session has to be open in the project,
# which is the very thing that creates those.
#
# Two classes of pre-existing file, treated differently:
#   USER-OWNED (machine-local, gitignored by our own .claude/.gitignore):
#     never overwritten, never a reason to refuse — kept as they are.
#   EVERYTHING ELSE the template ships: a clash means this project is already
#     scaffolded, so refuse and name the files rather than overwrite them.
USER_OWNED="settings.local.json CLAUDE.local.md"
is_user_owned() { case " $USER_OWNED " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# `.claude` must be a directory if it exists at all.
if [ -e ".claude" ] && [ ! -d ".claude" ]; then
  echo "❌ .claude exists but is not a directory — move it aside and re-run."
  exit 1
fi

if [ -d ".claude" ]; then
  clashes=""
  # Files the template would write.
  while IFS= read -r rel; do
    if [ -e ".claude/$rel" ] && ! is_user_owned "$rel"; then
      clashes="$clashes      $rel
"
    fi
  done < <(cd "$TEMPLATE" && find . -type f | sed 's|^\./||' | sort)
  # dot-gitignore lands as .claude/.gitignore, so that name is a clash too.
  if [ -f "$TEMPLATE/dot-gitignore" ] && [ -e ".claude/.gitignore" ]; then
    clashes="$clashes      .gitignore
"
  fi
  # A plain FILE where the template needs a directory would make cp fail
  # per-file while the script marched on to report success.
  while IFS= read -r rel; do
    if [ -e ".claude/$rel" ] && [ ! -d ".claude/$rel" ]; then
      clashes="$clashes      $rel (expected a directory)
"
    fi
  done < <(cd "$TEMPLATE" && find . -mindepth 1 -type d | sed 's|^\./||' | sort)

  if [ -n "$clashes" ]; then
    echo "⚠️  These files already exist in .claude/ and would be overwritten:"
    printf '%s' "$clashes"
    echo "   To refresh the infrastructure in place:  update-claude   (or /update-floor)"
    echo "   To re-scaffold from scratch: remove .claude/ first (back up CLAUDE.md and PROGRESS.md)."
    exit 1
  fi
  scaffold_into_existing=1
fi

# ── Pre-flight: can we write what the Claude app's sandbox protects? ─────────
# In the desktop app, Bash runs sandboxed, and .git/hooks/ and
# .claude/settings*.json are protected so Claude can't change its own
# permissions or plant hooks — exactly what this script writes. A denied write
# mid-copy left a partial scaffold that then had to be finished by hand
# (2026-10-16). So test those paths FIRST, and change nothing if any is denied.
probe_create() { # true if $1 already exists (we won't write it) or can be created
  [ -e "$1" ] && return 0
  ( : > "$1" ) 2>/dev/null || return 1
  rm -f "$1" 2>/dev/null || { echo "⚠️  couldn't remove probe file $1 — delete it before re-running."; return 1; }
}
probe_overwrite() { # true if $1 is absent, or present and writable (append-open: changes nothing)
  [ -e "$1" ] || return 0
  ( : >> "$1" ) 2>/dev/null
}
made_claude_dir=0
[ -d .claude ] || { mkdir .claude 2>/dev/null && made_claude_dir=1; }
denied=""
for f in .claude/settings.json .claude/settings.local.json; do
  probe_create "$f" || denied="$denied      $f
"
done
if [ -d ".git" ]; then
  # git doesn't need hooks/ to pre-exist, and its absence isn't the sandbox.
  mkdir -p .git/hooks 2>/dev/null
  probe=".git/hooks/.init-claude-probe-$$"
  probe_create "$probe" || denied="$denied      .git/hooks/
"
  # The hooks are overwritten below, so an existing one must be writable too.
  for h in pre-commit pre-push; do
    probe_overwrite ".git/hooks/$h" || denied="$denied      .git/hooks/$h (exists, not writable)
"
  done
fi
if [ -n "$denied" ]; then
  [ "$made_claude_dir" -eq 1 ] && rmdir .claude 2>/dev/null
  echo "❌ Can't write these — nothing was changed:"
  printf '%s' "$denied"
  echo "   Most likely cause: in the Claude desktop app, Bash runs in a sandbox that"
  echo "   protects them (so Claude can't change its own permissions or plant git hooks)."
  echo "   Run the scaffolder once outside the sandbox — paste this into a terminal:"
  echo "     cd \"$PWD\" && bash \"$SCRIPT_DIR/$(basename "$0")\""
  exit 1
fi

[ "${scaffold_into_existing:-0}" -eq 1 ] && \
  echo "ℹ️  .claude/ exists but holds no scaffolding (e.g. only the app's own files) — scaffolding into it."
mkdir -p .claude
# "$TEMPLATE/." (not "$TEMPLATE") so the CONTENTS merge into an existing
# .claude/; `cp -r "$TEMPLATE" .claude` would nest a whole copy of the template
# inside it. -n never clobbers, so a user-owned file already there survives.
cp -Rn "$TEMPLATE/." .claude/ 2>/dev/null
# Do NOT trust cp's exit status here: with -n, BSD cp exits 1 merely because it
# SKIPPED an existing file. Assert the post-condition instead — every file the
# template ships is now present — so a partial copy can never report success.
missing=""
while IFS= read -r rel; do
  [ -e ".claude/$rel" ] || missing="$missing      $rel
"
done < <(cd "$TEMPLATE" && find . -type f | sed 's|^\./||' | sort)
if [ -n "$missing" ]; then
  echo "❌ Scaffold incomplete — these template files did not land in .claude/:"
  printf '%s' "$missing"
  echo "   .claude/ is partially scaffolded; fix the cause and re-run."
  exit 1
fi
# In the repo/plugin the .claude-internal gitignore is stored as dot-gitignore
# (a literal .gitignore would make git ignore template files). Restore its name.
# The guard above already refused if .claude/.gitignore pre-existed, so this
# rename cannot clobber one; the rm arm is belt-and-braces only.
if [ -f .claude/dot-gitignore ]; then
  if [ -e .claude/.gitignore ]; then rm -f .claude/dot-gitignore
  else mv .claude/dot-gitignore .claude/.gitignore
  fi
fi

# Add project-root .gitignore if none exists
if [ ! -f ".gitignore" ]; then
  cp "$TEMPLATE/.project-gitignore" .gitignore
  echo "✅ .gitignore added (env, secrets, credentials, cloud configs)"
else
  echo "ℹ️  .gitignore already exists — skipped. Review it to ensure .env* is ignored."
fi

# Install the two-tier floor hooks if this is a git repo (#14):
#   pre-commit → secret scan + quick floor (lint+typecheck) on the staged snapshot
#   pre-push   → the FULL floor (adds tests)
if [ -d ".git" ]; then
  cp "$TEMPLATE/.pre-commit-hook" .git/hooks/pre-commit
  chmod +x .git/hooks/pre-commit
  cp "$TEMPLATE/.pre-push-hook" .git/hooks/pre-push
  chmod +x .git/hooks/pre-push
  echo "✅ Git hooks installed (pre-commit: secrets + quick floor; pre-push: full floor)"
else
  echo "ℹ️  Not a git repo — skipping git hooks. Run 'git init' first, then re-run init-claude."
fi

# The deterministic floor: one verify.sh that every gate runs.
chmod +x .claude/verify.sh 2>/dev/null  # best-effort; the template file is already +x (S2)
echo "✅ .claude/verify.sh installed (the floor: lint + typecheck + test)"

# ── Tier 4: drop stack starter configs at the project root (never overwrite) ──
drop() { # drop <template-under-.claude/configs> <target-at-root>
  # Returns 0 ONLY when it created the file, so callers can post-process a
  # freshly dropped starter config without ever touching a user's own.
  if [ -f ".claude/configs/$1" ] && [ ! -e "$2" ]; then
    cp ".claude/configs/$1" "$2"
    echo "✅ $2 added (starter config — edit per project)"
    return 0
  fi
  return 1
}

# Align the starter ruff.toml with the Python this project actually targets.
# The template ships a fixed target-version, so without this every project got
# it regardless of .python-version / requires-python, and ruff's pyupgrade (UP)
# rules silently applied the wrong baseline.
ruff_pin_target_version() {
  local v="" src=""
  if [ -f .python-version ]; then
    v=$(grep -oE '3\.[0-9]+' .python-version | head -1); src=".python-version"
  fi
  if [ -z "$v" ] && [ -f pyproject.toml ]; then
    v=$(grep -m1 -E '^[[:space:]]*requires-python' pyproject.toml | grep -oE '3\.[0-9]+' | head -1)
    src="requires-python"
  fi
  [ -n "$v" ] || return 0   # nothing to go on — keep the template default
  local tv="py${v%.*}${v#*.}"
  sed -i.bak -E "s/^target-version = \".*\"/target-version = \"$tv\"/" ruff.toml 2>/dev/null \
    && rm -f ruff.toml.bak \
    && echo "   ↳ ruff target-version set to $tv (from $src)"
}
FLOOR_GAP=""
if [ -f "package.json" ]; then
  drop "eslint.config.mjs.tpl"   "eslint.config.mjs"
  drop "tsconfig.base.json.tpl"  "tsconfig.json"
  drop "prettierrc.json.tpl"     ".prettierrc.json"
  # ── Tier 2: floor check — a JS project with no test script has no test floor ──
  if ! node -e "process.exit(require('./package.json').scripts && require('./package.json').scripts.test ? 0 : 1)" 2>/dev/null; then
    FLOOR_GAP="No \"test\" script in package.json — this project ships with NO test floor."
  fi
fi
if [ -f "pyproject.toml" ] || [ -f "setup.py" ] || ls ./*.py >/dev/null 2>&1; then
  drop "ruff.toml.tpl" "ruff.toml" && ruff_pin_target_version
  # ── Tier 2: floor check — does this project actually HAVE tests? ──
  # A runner on $PATH proves nothing about THIS project. `uv init` does not
  # create uv.lock (it appears on the first `uv add`/`uv sync`), so a fresh uv
  # project fell through to `command -v pytest` and any globally-installed
  # pytest silently satisfied the check — reporting a test floor that did not
  # exist. That is the precise false-green verify.sh's own header warns about.
  #
  # Look for test FILES: the one signal that is about the project rather than
  # the machine. Deliberately a pure filesystem check — a `pytest --collect-only`
  # probe would be more precise but executes conftest.py, and init-claude must
  # stay a scaffolder that never runs project code.
  if ! find . \( -name .venv -o -name venv -o -name node_modules -o -name .git \) -prune \
       -o \( -name 'test_*.py' -o -name '*_test.py' \) -print 2>/dev/null | grep -q .; then
    FLOOR_GAP="no test files (test_*.py / *_test.py) found — this Python project ships with NO test floor."
  fi
fi

# Surface a missing test floor LOUDLY and durably (PROGRESS.md is read every
# Session Start) so it's an owned decision, never a silent slip. See qa.md.
if [ -n "$FLOOR_GAP" ]; then
  echo ""
  echo "⚠️  TEST FLOOR GAP: $FLOOR_GAP"
  echo "    Per qa.md, this is a blocking decision: wire a test runner, or"
  echo "    explicitly accept the gap with the user before writing code."
  {
    echo ""
    echo "## ⚠️ Known Issue — test floor gap (flagged by init-claude)"
    echo "- $FLOOR_GAP"
    echo "- Per qa.md: wire a test runner or get an explicit decision before relying on this code."
  } >> .claude/PROGRESS.md
fi

# Clean up template-only files that shouldn't live inside .claude/
rm -f .claude/.project-gitignore
rm -f .claude/.pre-commit-hook
rm -f .claude/.pre-push-hook

echo "✅ .claude/ scaffolded"
echo ""
echo "Next steps:"
echo "  1. Edit .claude/CLAUDE.md — fill in tech stack, and the lint/typecheck/test commands"
echo "  2. Edit .claude/verify.sh — confirm it runs your real lint + typecheck + test"
echo "  3. Enable the merge gate: copy a file from .claude/ci/ and follow .claude/ci/BRANCH_PROTECTION.md"
echo "  4. Edit .claude/settings.local.json — add your allowed commands"
echo "  5. Commit .claude/ (CLAUDE.local.md and settings.local.json are gitignored)"
